{
  "name": "simple-db-viewer",
  "version": "1.0.4",
  "description": "Simple database viewer for PostgreSQL, MySQL, SQLite, and MongoDB (optional helper, not part of DB container runtime)",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": "18.x"
  },
  "scripts": {
    "prestart": "node -v && (npm ci || npm install)",
    "start": "node server.js",
    "dev": "nodemon server.js"
  },
  "dependencies": {
    "express": "4.18.2",
    "pg": "8.11.3",
    "mysql2": "3.6.3",
    "sqlite3": "5.1.6",
    "mongodb": "6.2.0",
    "ipaddr.js": "2.1.0",
    "cookie": "0.5.0",
    "encodeurl": "1.0.2",
    "finalhandler": "1.2.0",
    "merge-descriptors": "1.0.1",
    "path-to-regexp": "0.1.7",
    "qs": "6.11.0",
    "send": "0.18.0",
    "serve-static": "1.15.0",
    "raw-body": "2.5.2"
  },
  "devDependencies": {
    "nodemon": "3.0.1"
  }
}