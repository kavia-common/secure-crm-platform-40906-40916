# crm_database environment variables
# Copy this file to .env and adjust values as needed. All variables are optional;
# startup.sh will fall back to safe defaults if not provided and will log warnings.

# PostgreSQL database name (default: myapp)
POSTGRES_DB=myapp

# PostgreSQL username (default: appuser)
POSTGRES_USER=appuser

# PostgreSQL password (default: dbuser123)
POSTGRES_PASSWORD=dbuser123

# PostgreSQL port bound on localhost inside the container (default: 5000)
POSTGRES_PORT=5000

# Notes:
# - The database listens on localhost only by default for security.
# - The FastAPI backend container should connect via the Docker network; adjust listen
#   settings in startup.sh if needed for non-localhost bindings (not recommended for dev).
# - Do not commit real secrets to version control; use environment-specific .env files.
